{
  "name": "catcham",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agency incident reporting, investigation and evidence management platform",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "setup": "pnpm install && pnpm db:generate && pnpm db:migrate && pnpm db:seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "esbuild",
      "@nestjs/core"
    ],
    "//": "The web and mobile apps each pull their own @types/react. Two copies in the tree make React's own JSX types mutually incompatible, so both are pinned to one version.",
    "overrides": {
      "@types/react": "18.3.12",
      "@types/react-dom": "18.3.1"
    }
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@types/node": "^22.5.0",
    "prettier": "^3.3.3",
    "prisma": "^5.19.1",
    "tsx": "^4.19.0",
    "turbo": "^2.1.1",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.23.0"
}
