NODE_ENV=development

# API server
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Database. SQLite file path, relative to the repository root.
DATABASE_URL="file:./data/catcham.db"

# Authentication. Replace both secrets before deploying; each must be at least
# 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_characters
JWT_REFRESH_TTL=7d

# Evidence storage. Files are written to disk under this directory.
STORAGE_ROOT=./data/evidence
UPLOAD_MAX_BYTES=52428800

# Rate limiting for anonymous submission and tracking endpoints.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# Notification delivery. Leave SMTP_HOST empty to log notifications instead of
# sending them, which is the default in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CATCHAM <no-reply@catcham.local>"

# Seed credentials. Used only by `pnpm db:seed`.
SEED_ADMIN_EMAIL=admin@catcham.local
SEED_ADMIN_PASSWORD=ChangeMe123!
