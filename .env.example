# Environment
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000/api/v1
WEB_BASE_URL=http://localhost:3000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://catcham:catcham_secure_pwd@localhost:5432/catcham_db?schema=public

# Redis & Queues
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=catcham_redis_secret

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=super_secret_refresh_key_at_least_32_characters_long
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_SALT_ROUNDS=12

# Object Storage (S3 / MinIO)
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_EVIDENCE=catcham-evidence
STORAGE_BUCKET_UPLOADS=catcham-uploads

# AI Service (FastAPI)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=catcham_ai_internal_token

# Email / SMS Gateway (Nigeria-compatible)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
DEFAULT_FROM_EMAIL=no-reply@catcham.ng
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=CATCHAM
