{
  "name": "@catcham/api",
  "version": "0.1.0",
  "private": true,
  "description": "CATCHAM Primary Modular Monolith API Gateway & Application Server",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@catcham/analytics": "workspace:*",
