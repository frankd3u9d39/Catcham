    "@catcham/core": "workspace:*",
    "@catcham/evidence": "workspace:*",
    "@catcham/gis": "workspace:*",
    "@catcham/identity": "workspace:*",
    "@catcham/investigation": "workspace:*",
    "@catcham/notification": "workspace:*",
    "@catcham/organization": "workspace:*",
    "@catcham/reporting": "workspace:*",
    "@catcham/search": "workspace:*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.3.0",
    "@nestjs/terminus": "^10.2.0",
